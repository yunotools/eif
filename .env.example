EIF_PORT=8080
EIF_STATIC_DIR=./web/static

EIF_READ_HEADER_TIMEOUT=10s
EIF_SHUTDOWN_TIMEOUT=10s

EIF_LOG_LEVEL=info
EIF_LOG_FORMAT=json

EIF_CORS_ALLOWED_ORIGINS=http://localhost:3000

EIF_HDDT_GDT_ENDPOINT=https://hoadondientu.gdt.gov.vn
EIF_HDDT_GDT_TIMEOUT=60s
EIF_HDDT_GDT_MAX_QUERY_DAYS=31
EIF_HDDT_GDT_MAX_EXPORT_DAYS=31

# Chống rate-limit GDT
EIF_HDDT_GDT_MIN_REQUEST_INTERVAL=500ms
EIF_HDDT_GDT_RATE_LIMIT_RETRIES=4
EIF_HDDT_GDT_RATE_LIMIT_BASE_DELAY=1s
EIF_HDDT_GDT_QUERY_CACHE_TTL=45s

# Session
EIF_SESSION_EXPIRY_SKEW=30s
EIF_SESSION_STORE_PATH=./runtime/hddtgdt-sessions.enc

# BẮT BUỘC: Base64 của đúng 32 random bytes
EIF_SESSION_ENCRYPTION_KEY=PUT_BASE64_32_BYTE_KEY_HERE